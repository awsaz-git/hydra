# Copy to .env.local (gitignored) and fill in. Both keys: Clerk dashboard → Configure → API keys.
# Development instance keys start with pk_test_ / sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-side only (no NEXT_PUBLIC_ prefix, so Next.js never sends it to the browser).
# clerkMiddleware and auth() need it to read the session; account deletion uses it too.
CLERK_SECRET_KEY=

# Where /api/* is forwarded (default http://localhost:8080)
# BACKEND_URL=http://localhost:8080
