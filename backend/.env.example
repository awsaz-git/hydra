# Copy to .env (gitignored) and fill in the values. Locally these point at the Neon "staging" branch.
LLM_API_KEY=

# The running server: role hydra_app, Neon's POOLED host (contains "-pooler"), ends in /hydra?sslmode=require
DATABASE_URL=

# Only for `go run . migrate`: role hydra_owner, Neon's DIRECT host (pooling off), ends in /hydra?sslmode=require
MIGRATE_DATABASE_URL=

# Optional: the coach's persona name in the system prompt (default Hydra). See docs/BRAND.md.
# COACH_NAME=Hydra
