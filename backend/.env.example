# Copy to .env (gitignored) and fill in the values. Locally these point at the Neon "staging" branch.
LLM_API_KEY=

# The running server: role hydra_app, Neon's POOLED host (contains "-pooler"), ends in /hydra?sslmode=require
DATABASE_URL=

# Only for `go run . migrate`: role hydra_owner, Neon's DIRECT host (pooling off), ends in /hydra?sslmode=require
MIGRATE_DATABASE_URL=

# Optional: the coach's persona name in the system prompt (default Hydra). See docs/BRAND.md.
# COACH_NAME=Hydra

# Clerk (auth). Both are public values, not secrets: the backend holds no Clerk secret.
# CLERK_JWT_KEY: Clerk dashboard → API keys → "JWKS Public Key" (PEM). Paste it inside ONE pair of
# double quotes, keeping its line breaks:
#   CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
#   ...
#   -----END PUBLIC KEY-----"
CLERK_JWT_KEY=
# The frontend origins allowed to send tokens (comma-separated, no trailing slash)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
